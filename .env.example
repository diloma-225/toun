# Copier ce fichier en .env sur le serveur, puis remplir les valeurs.

# Port du serveur sur lequel le site répond
APP_PORT=8080
# Adresse publique du site (retours de paiement)
SITE_URL=https://votre-domaine.com
TZ=Africa/Abidjan

# Base de données (mots de passe à inventer, longs et différents)
DB_NAME=bd_toun
DB_USER=toun
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Paiement : jeko, fedapay ou cinetpay
PAIEMENT_FOURNISSEUR=jeko
JEKO_CLE=
JEKO_CLE_ID=
JEKO_BOUTIQUE=
FEDAPAY_CLE_SECRETE=
# sandbox ou live
FEDAPAY_MODE=sandbox
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
PAIEMENT_SIMULATION=false
